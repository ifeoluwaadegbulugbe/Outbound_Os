# ─────────────────────────────────────────────────────────────────────────────
# Outbound OS — environment. Copy to .env.local (development) or set in your
# host's environment (production). Never commit real secrets.
# Everything here is optional in development: the app runs with zero config.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this app (used for tracked links /r/<code>).
APP_URL=http://localhost:3100

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty in development to use the embedded Postgres (PGlite, stored in
# ~/.outbound-os/, outside the project). In production set a Postgres 15+ URL (Supabase/Neon/RDS — a NEW
# project, separate from Orbit). Free tiers of Supabase/Neon work.
DATABASE_URL=
# Allow the embedded DB under `npm start` (single machine, local use only).
# ALLOW_PGLITE_IN_PRODUCTION=1
# Supabase transaction pooler (port 6543) needs prepared statements off.
# DB_PREPARE=false
# Role used for row-level security (created by the first migration).
DB_RLS_ROLE=ob_app
# Run migrations automatically on boot (default: true for embedded DB only).
# AUTO_MIGRATE=true

# ── Security ────────────────────────────────────────────────────────────────
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts integration
# secrets at rest. Required in production; auto-generated in development.
ENCRYPTION_KEY=
# Bearer token for /api/cron/* (job worker tick, follow-up scheduler).
CRON_SECRET=
# HMAC secret Orbit uses to sign conversion webhooks (POST /api/v1/conversions).
CONVERSION_WEBHOOK_SECRET=

# ── Product you're selling ─────────────────────────────────────────────────
# Where tracked links send people. UTM params + an opaque ref code are added.
PRODUCT_SIGNUP_URL=https://app.getorbitcrm.com/signup

# ── AI (all optional, all free options) ────────────────────────────────────
# Without any key the system uses deterministic templates and rules (labelled
# "Template" in the UI). Provider order: first configured wins.
# Ollama runs locally and is free: https://ollama.com  (e.g. `ollama pull llama3.1:8b`)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# Groq free tier: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Anthropic (paid): https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Email sending (your own mailbox via OAuth; see docs/email.md) ─────────
# Google Cloud OAuth client (Web). Redirect URI: {APP_URL}/api/email/oauth/gmail/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration. Redirect URI: {APP_URL}/api/email/oauth/microsoft/callback
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Mailbox-level verification (100 free/month). Can also be set in Data Sources.
# ZEROBOUNCE_API_KEY=
# Dev-only test mailbox that never delivers. On by default outside production.
# ENABLE_TEST_SINK=false

# ── Discovery sources ──────────────────────────────────────────────────────
# Instagram Graph API (official, free): configured in-app under Integrations
# (token is stored encrypted). See docs/integrations.md for Meta app setup.
# OpenStreetMap Overpass endpoint. The public one is fine for low volume;
# use a self-hosted/paid instance for heavy commercial use.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Mock discovery source (fictional businesses) — development only.
ENABLE_MOCK_SOURCES=true

# ── Development seed (used by `npm run db:seed`) ───────────────────────────
SEED_OWNER_EMAIL=owner@outbound.local
SEED_OWNER_PASSWORD=change-me-dev-only-1
