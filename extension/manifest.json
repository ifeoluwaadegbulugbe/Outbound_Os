{
  "manifest_version": 3,
  "name": "Outbound OS Assistant",
  "version": "0.1.1",
  "description": "Opens each approved DM with your message already typed. You press Send — it never sends for you.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Outbound OS" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*", "https://www.tiktok.com/*"],
      "js": ["composer.js"],
      "run_at": "document_idle"
    }
  ]
}
